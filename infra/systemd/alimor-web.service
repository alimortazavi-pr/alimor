[Unit]
Description=alimor.ir personal website (Next.js)
After=network-online.target
[Service]
User=alimor
Group=alimor
WorkingDirectory=/opt/alimor/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=7742
EnvironmentFile=/opt/alimor/shared/web.env
ExecStart=/opt/alimor/runtime/node server.js
Restart=always
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/alimor/current/.next
MemoryHigh=300M
MemoryMax=450M
[Install]
WantedBy=multi-user.target
